set_global_assignment -name FAMILY "Cyclone 10 LP"
set_global_assignment -name DEVICE 10CL025YU256C8G
set_global_assignment -name TOP_LEVEL_ENTITY cyc1000_blinky
set_global_assignment -name VERILOG_FILE cyc1000_blinky.v
set_global_assignment -name SDC_FILE cyc1000_blinky.sdc

set_location_assignment PIN_M2 -to clk12
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk12
set_location_assignment PIN_M6 -to user_led[0]
set_location_assignment PIN_T4 -to user_led[1]
set_location_assignment PIN_T3 -to user_led[2]
set_location_assignment PIN_R3 -to user_led[3]
set_location_assignment PIN_T2 -to user_led[4]
set_location_assignment PIN_R4 -to user_led[5]
set_location_assignment PIN_N5 -to user_led[6]
set_location_assignment PIN_N3 -to user_led[7]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to user_led[*]

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"