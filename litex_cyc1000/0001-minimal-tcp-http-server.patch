--- a/litex/soc/software/libliteeth/udp.h	2026-09-19 18:06:29.729749948 +0200
+++ b/a/litex/soc/software/libliteeth/udp.h	2026-09-20 23:45:33.183356638 +0200
@@ -35,6 +35,73 @@
 void eth_init(void);
 void eth_mode(void);
 
+/* --- TCP dispatch + low-level helpers exposed for firmware --- */
+
+#include <stdint.h>
+
+#ifndef HW_PREAMBLE_CRC
+struct ethernet_header {
+	uint8_t  preamble[8];
+	uint8_t  destmac[6];
+	uint8_t  srcmac[6];
+	uint16_t ethertype;
+} __attribute__((packed));
+#else
+struct ethernet_header {
+	uint8_t  destmac[6];
+	uint8_t  srcmac[6];
+	uint16_t ethertype;
+} __attribute__((packed));
+#endif
+
+struct ip_header {
+	uint8_t  version;
+	uint8_t  diff_services;
+	uint16_t total_length;
+	uint16_t identification;
+	uint16_t fragment_offset;
+	uint8_t  ttl;
+	uint8_t  proto;
+	uint16_t checksum;
+	uint32_t src_ip;
+	uint32_t dst_ip;
+} __attribute__((packed));
+
+struct tcp_header {
+	uint16_t src_port;
+	uint16_t dst_port;
+	uint32_t seq_num;
+	uint32_t ack_num;
+	uint8_t  data_offset;
+	uint8_t  flags;
+	uint16_t window;
+	uint16_t checksum;
+	uint16_t urgent;
+} __attribute__((packed));
+
+struct tcp_frame {
+	struct ip_header  ip;
+	struct tcp_header tcp;
+	char payload[];
+} __attribute__((packed));
+
+typedef void (*tcp_callback)(uint32_t src_ip, struct tcp_frame *frame,
+                             uint32_t raw_len);
+void tcp_set_callback(tcp_callback callback);
+
+/* TX helpers */
+int          eth_send_packet(void);
+void         eth_fill_header(struct ethernet_header *h,
+                             const uint8_t *destmac,
+                             const uint8_t *srcmac,
+                             uint16_t ethertype);
+uint16_t     eth_ip_checksum(uint32_t r, void *buffer,
+                             uint32_t length, int complete);
+uint8_t     *eth_get_tx_buffer(void);
+void         eth_set_tx_len(int len);
+uint8_t     *eth_get_my_mac(void);
+uint32_t     eth_get_my_ip(void);
+
 #ifdef __cplusplus
 }
 #endif
